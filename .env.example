ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_ENABLED=true
SENTRY_DSN=
ALLOW_SYNTHETIC_TRACE_DATA=false
